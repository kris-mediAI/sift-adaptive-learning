def track_description(subject):
    """Return the user-facing description for a supported learning track."""
    descriptions = {
        "Python": "Build programming fluency through hands-on practice.",
        "Data Structures & Algorithms": (
            "Master data structures and algorithmic thinking."
        ),
        "Machine Learning": (
            "Learn ML concepts and build intelligent systems."
        ),
        "Mathematics": (
            "Strengthen mathematical foundations and problem-solving."
        ),
    }
    return descriptions.get(
        subject,
        "Adaptive learning for this supported track.",
    )


def get_track_profile(subject):
    profiles = st.session_state.track_profiles
    return profiles.get(subject)


def remember_track(subject, learner_id):
    st.session_state.track_profiles[subject] = learner_id


def create_or_restore_track(subject, minutes, days, level, goal, name):
    """
    Each subject gets its own persisted learner/session state.

    The existing orchestrator remains the source of truth. We do not
    create a fake in-memory progress model for the learning engine.
    """
    learner_id, _ = sift.get_or_create_learner(
        name=name.strip(),
        goal=goal.strip(),
        subject=subject,
        available_minutes=int(minutes),
        current_level=level,
        target_days=int(days),
    )
    sift.create_session(learner_id, subject=subject)
    remember_track(subject, learner_id)
    return learner_id


def ensure_active_track():
    subject = st.session_state.active_track
    if subject:
        return subject

    profiles = st.session_state.track_profiles
    if profiles:
        subject = next(iter(profiles.keys()))
        st.session_state.active_track = subject
        return subject

    return None


def get_active_session():
    subject = ensure_active_track()
    if not subject:
        return None

    learner_id = get_track_profile(subject)
    if not learner_id:
        return None

    return sift.get_session(learner_id)


def get_active_learner():
    session = get_active_session()
    return session.learner if session else None


def today_minutes_(learner):
    """Return actual active-learning minutes recorded for today."""
    if learner is None:
        return 0.0
    state = getattr(learner, "activity_streak", {}) or {}
    today = __import__("datetime").datetime.now().astimezone().date().isoformat()
    return float((state.get("daily_minutes", {}) or {}).get(today, 0) or 0)


def recommendation_for(session):
    if session is None:
        return None

    try:
        return session.engine.recommend(
            learner=session.learner,
            concepts=list(session.concepts.values()),
            focus_concept=getattr(session, "focus_concept", None),
        )
    except Exception as exc:
        st.session_state["recommendation_error"] = str(exc)
        return None


def active_task_from_session(session):
    """Return one clean learner-facing task from the active backend intervention."""
    active = getattr(session, "active_intervention", None)
    if not isinstance(active, dict):
        return None

    candidates = (
        active.get("intervention"),
        active.get("task"),
        active,
    )
    task = next(
        (candidate for candidate in candidates if isinstance(candidate, dict)),
        None,
    )
    if task is None:
        return None

    task = dict(task)

    for key in (
        "strategy", "concept", "title", "question", "action",
        "target_concept", "difficulty", "question_type",
    ):
        if key not in task and key in active:
            task[key] = active[key]

    question = task.get("question") or task.get("task")
    if not question:
        return None

    task["question"] = question
    return task


def is_diagnostic(recommendation):
    return bool(
        recommendation
        and recommendation.get("action") == "diagnostic"
    )


def diagnostic_question(subject):
    questions = {
        "Python": (
            "Explain the difference between a list and a tuple in Python. "
            "Give one situation where you would choose each."
        ),
        "Data Structures & Algorithms": (
            "Explain the difference between a stack and a queue. "
            "Give one real-world or programming example of each."
        ),
        "Machine Learning": (
            "Explain the difference between training data and test data, "
            "and why a model should not be evaluated only on training data."
        ),
        "Mathematics": (
            "Explain what it means for a function to be increasing on an interval. "
            "Give a simple example."
        ),
    }
    return questions.get(
        subject,
        "Explain one important concept from this subject in your own words and give an example.",
    )


def show_generation_error(exc):
    message = str(exc or "")
    low = message.lower()

    if (
        "429" in low
        or "resource_exhausted" in low
        or "quota" in low
        or "rate limit" in low
    ):
        st.warning(
            "Sift's AI task generator is temporarily rate-limited. "
            "Your learning data is safe; try again shortly."
        )
    elif (
        "no content model" in low
        or "api key" in low
        or "not configured" in low
    ):
        st.error(
            "Sift's AI task generator is not configured correctly. "
            "Check the Gemini configuration."
        )
    elif (
        "novel" in low
        or "contentvalidation" in low
        or "valid novel" in low
    ):
        st.warning(
            "Sift generated content that did not pass its learning-quality "
            "checks, so it was not shown."
        )
    else:
        st.error(
            "Sift could not generate a valid learning task right now."
        )

    with st.expander("Technical details"):
        st.code(message or "No additional details were returned.")


def show_completion_error(exc):
    message = str(exc or "")
    low = message.lower()

    if (
        "429" in low
        or "resource_exhausted" in low
        or "quota" in low
    ):
        st.warning(
            "Sift's AI evaluator is temporarily rate-limited. "
            "Your learning state is safe."
        )
    else:
        st.error("Sift could not complete this learning turn.")

    with st.expander("Technical details"):
        st.code(message or "No additional details were returned.")


