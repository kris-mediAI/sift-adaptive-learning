def render_track_switcher():
    st.markdown(
        '<div class="section-title compact">My learning tracks</div>',
        unsafe_allow_html=True,
    )

    cols = st.columns(len(subjects))

    for col, subject in zip(cols, subjects):
        profile_exists = subject in st.session_state.track_profiles
        selected = subject == st.session_state.active_track

        with col:
            card_class = "track-card selected" if selected else "track-card"
            status = "Active" if selected else ("Continue" if profile_exists else "Add track")
            mastery = "—"

            if profile_exists:
                try:
                    profile = sift.get_session(
                        st.session_state.track_profiles[subject]
                    )
                    concepts = getattr(profile, "concepts", {}) or {}
                    values = [
                        float(getattr(c, "mastery", 0) or 0)
                        for c in concepts.values()
                    ]
                    if values:
                        mastery = f"{sum(values) / len(values):.0f}%"
                except Exception:
                    mastery = "—"

            st.markdown(
                f'<div class="{card_class}">'
                f'<div class="track-visual">{track_visual(subject)}</div>'
                f'<div class="track-name">{subject}</div>'
                f'<div class="track-desc">{track_description(subject)}</div>'
                f'<div class="track-bottom"><span class="badge blue">{status}</span>'
                f'<span class="track-mastery">{mastery}</span></div>'
                f'</div>',
                unsafe_allow_html=True,
            )

            button_label = (
                "Selected"
                if selected
                else ("Switch to track" if profile_exists else "Add track")
            )

            if st.button(
                button_label,
                key=f"track_switch_{subject}",
                use_container_width=True,
                disabled=selected,
            ):
                if profile_exists:
                    st.session_state.active_track = subject
                    st.session_state.last_result = None
                    st.session_state.resource_bundle = None
                    st.session_state.current_view = "home"
                    st.rerun()
                else:
                    st.session_state["pending_add_subject"] = subject
                    st.session_state["add_track_subject"] = subject
                    st.session_state.current_view = "add_track"
                    st.rerun()


