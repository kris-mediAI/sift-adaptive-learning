            title=f"{concept} · {strategy}"
            summary=f"{float(pre):.0f}% → {float(post):.0f}% mastery" if pre is not None and post is not None else "Learning evidence recorded"
            with st.expander(f"{title} — {summary}", expanded=(idx==0)):
                m1,m2,m3=st.columns(3)
                with m1: metric_card("Mastery change", f"{float(gain):+.1f}" if gain is not None else "—", "This learning turn")
                with m2: metric_card("Time", f"{float(getattr(record,'duration_seconds',0) or 0)/60:.1f} min", "Recorded learning time")
                with m3: metric_card("Result", f"{float((getattr(record,'evaluation',{}) or {}).get('score',0)):.0f}%" if (getattr(record,'evaluation',{}) or {}).get('score') is not None else "—", "Assessment evidence")
                question=getattr(record,"question",None)
                answer=getattr(record,"answer",None)
                evaluation=getattr(record,"evaluation",{}) or {}
                if question: st.markdown(f"**What Sift asked**\n\n{question}")
                if answer: st.markdown(f"**Your answer**\n\n{answer}")
                if evaluation:
                    st.markdown("**How Sift evaluated it**")
                    st.write(evaluation.get("explanation") or evaluation.get("feedback") or "Evaluation recorded.")
                    if evaluation.get("misconception"): st.warning(f"Misconception detected: {evaluation['misconception']}")
                    if evaluation.get("mistake_type") and evaluation.get("mistake_type") != "none": st.caption(f"Evidence type: {evaluation['mistake_type']}")
                st.caption("Sift uses this evidence to update mastery and choose future practice; the latest answer is not the only signal.")

