    st.markdown('</div>', unsafe_allow_html=True)

    st.markdown('<div class="analytics-grid">', unsafe_allow_html=True)
    st.markdown('<div class="analytics-panel"><div class="analytics-title">Concept mastery</div><div class="analytics-copy">Where your current evidence is strongest.</div>', unsafe_allow_html=True)
    ranked = sorted(concepts.items(), key=lambda item: float(getattr(item[1], "mastery", 0) or 0), reverse=True)
    if ranked:
        for name, data in ranked[:6]:
            mastery_bar(name, getattr(data, "mastery", 0), getattr(data, "attempts", 0), getattr(data, "correct_attempts", 0))
    else:
        st.markdown('<div class="gold-empty">Complete a learning turn and Sift will start building your mastery map.</div>', unsafe_allow_html=True)
    st.markdown('</div>', unsafe_allow_html=True)

    points = []
    for i, (_, data) in enumerate(ranked[:7]):
        points.append((i, float(getattr(data, "mastery", 0) or 0)))
    if not points:
        points = [(0, 10), (1, 12), (2, 15), (3, 18), (4, 20), (5, 23), (6, 25)]
    max_y = max(100.0, max(v for _, v in points))
    coords = []
    circles = []
    for i, value in points:
        x = 8 + (i / max(1, len(points) - 1)) * 84
        y = 92 - (value / max_y) * 78
        coords.append(f"{x:.1f},{y:.1f}")
        circles.append(f'<circle cx="{x:.1f}%" cy="{y:.1f}%" r="2.1"></circle>')
    svg = f'<svg viewBox="0 0 100 100" preserveAspectRatio="none"><polyline points="{" ".join(coords)}"></polyline>{"".join(circles)}</svg>'
    st.markdown(f'<div class="analytics-panel"><div class="analytics-title">Recent improvement</div><div class="analytics-copy">Your evidence is moving upward as you practice.</div><div class="improvement-chart">{svg}</div></div>', unsafe_allow_html=True)
    st.markdown('</div>', unsafe_allow_html=True)

